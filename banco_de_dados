CREATE DATABASE IF NOT EXISTS cadastro;
USE cadastro;

-- DADOS PESSOAIS

CREATE TABLE enderecos (
    -- AJUSTADO: Nome da PK alterado para o singular para combinar com as FKs
    pk_endereco INT AUTO_INCREMENT PRIMARY KEY,
    logradouro VARCHAR(150) NOT NULL,
    cep VARCHAR(9) NOT NULL,
    numero_endereco VARCHAR(10) NOT NULL,
    complemento ENUM('casa A', 'casa B', 'apartamento') DEFAULT NULL,
    municipio VARCHAR(100) NOT NULL,
    uf ENUM(
        'AC', 'AL', 'AP', 'AM', 'BA', 'CE', 'DF', 'ES',
        'GO', 'MA', 'MT', 'MS', 'MG', 'PA', 'PB', 'PR',
        'PE', 'PI', 'RJ', 'RN', 'RS', 'RO', 'RR', 'SC',
        'SP', 'SE', 'TO'
    ) NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    UNIQUE (cep, numero_endereco, complemento)
) ENGINE=InnoDB;

CREATE TABLE pessoas (
    pk_pessoa INT AUTO_INCREMENT PRIMARY KEY,
    fk_endereco INT NOT NULL,
    cpf_pessoa VARCHAR(14) NOT NULL UNIQUE,
    nome_pessoa VARCHAR(100) NOT NULL,
    data_nascimento DATE NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
        
    -- AJUSTADO: Apontando para o novo nome pk_endereco
    CONSTRAINT fk_pessoa_endereco
        FOREIGN KEY (fk_endereco) REFERENCES enderecos(pk_endereco) ON DELETE RESTRICT,

    CONSTRAINT chk_cpf_formatado
        CHECK (cpf_pessoa REGEXP '^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$')
) ENGINE=InnoDB;

CREATE INDEX idx_pessoa_nome ON pessoas(nome_pessoa);

CREATE TABLE emails (
    endereco_email VARCHAR(150) PRIMARY KEY,
    fk_pessoa INT NOT NULL UNIQUE,
    tipo_email ENUM('Pessoal', 'Institucional', 'Comercial', 'Academico'),
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_email_pessoa
        FOREIGN KEY (fk_pessoa) REFERENCES pessoas(pk_pessoa) ON DELETE CASCADE
) ENGINE=InnoDB;

-- AJUSTADO: Nome da tabela alterado de 'celular' para 'celulares' (padrao plural)
CREATE TABLE celulares (
    fk_pessoa INT NOT NULL PRIMARY KEY, 
    numero_celular VARCHAR(20) NOT NULL,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_celular_pessoa
        FOREIGN KEY (fk_pessoa) REFERENCES pessoas(pk_pessoa) ON DELETE CASCADE,

    CONSTRAINT chk_numero_celular
        CHECK (numero_celular REGEXP '^\\([0-9]{2}\\) [0-9]{5}-[0-9]{4}$')
) ENGINE=InnoDB;

--  DADOS ACADEMICOS (ENTIDADES BASE)

CREATE TABLE alunos (
    pk_rgm VARCHAR(15) PRIMARY KEY,
    fk_pessoa INT NOT NULL UNIQUE,
    tipo_aluno ENUM('PAGANTE', 'BOLSISTA_INTEGRAL', 'BOLSISTA_PARCIAL', 'FINANCIADO'),
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    CONSTRAINT fk_aluno_pessoa
        FOREIGN KEY (fk_pessoa) REFERENCES pessoas(pk_pessoa) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE cursos (
    pk_curso INT AUTO_INCREMENT PRIMARY KEY,
    nome_curso VARCHAR(100) NOT NULL,
    periodo_curso ENUM('Matutino','Vespertino','Noturno') DEFAULT NULL,
    tipo_curso ENUM('Presencial', 'EAD', 'Hibrido') DEFAULT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE disciplinas (
    pk_disciplina INT AUTO_INCREMENT PRIMARY KEY,
    nome_disciplina VARCHAR(100) NOT NULL,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE campus (
    pk_campus INT AUTO_INCREMENT PRIMARY KEY,
    nome_campus VARCHAR(50) NOT NULL UNIQUE,
    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE semestres (
    pk_semestre INT AUTO_INCREMENT PRIMARY KEY,
    fk_curso INT NOT NULL,
    numero_semestre INT NOT NULL CHECK (numero_semestre > 0), 
    
    UNIQUE (fk_curso, numero_semestre), 
    
    CONSTRAINT fk_semestre_curso 
        FOREIGN KEY (fk_curso) REFERENCES cursos(pk_curso) ON DELETE CASCADE
) ENGINE=InnoDB;

-- MATRICULAS E OFERTAS (RELAÇOES N:M)

CREATE TABLE aluno_curso (
    fk_aluno VARCHAR(15) NOT NULL,
    fk_curso INT NOT NULL,
    data_matricula TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

    CONSTRAINT pk_aluno_curso PRIMARY KEY (fk_aluno, fk_curso),

    CONSTRAINT fk_ac_aluno FOREIGN KEY (fk_aluno) REFERENCES alunos(pk_rgm) ON DELETE CASCADE,
    CONSTRAINT fk_ac_curso FOREIGN KEY (fk_curso) REFERENCES cursos(pk_curso) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE campus_curso (
    fk_campus INT NOT NULL,
    fk_curso INT NOT NULL,

    CONSTRAINT pk_campus_curso PRIMARY KEY(fk_campus, fk_curso),

    CONSTRAINT fk_cc_campus FOREIGN KEY (fk_campus) REFERENCES campus(pk_campus) ON DELETE CASCADE,
    CONSTRAINT fk_cc_curso FOREIGN KEY (fk_curso) REFERENCES cursos(pk_curso) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE semestre_disciplina (
    fk_semestre INT NOT NULL,
    fk_disciplina INT NOT NULL,
    
    CONSTRAINT pk_semestre_disciplina 
        PRIMARY KEY (fk_semestre, fk_disciplina),
    
    CONSTRAINT fk_sd_semestre 
        FOREIGN KEY (fk_semestre) REFERENCES semestres(pk_semestre) ON DELETE CASCADE,
        
    CONSTRAINT fk_sd_disciplina 
        FOREIGN KEY (fk_disciplina) REFERENCES disciplinas(pk_disciplina) ON DELETE CASCADE
) ENGINE=InnoDB;

-- HISTORICO ACADEMICO (NOTAS E FALTAS)

CREATE TABLE faltas (
    fk_rgm VARCHAR(15) NOT NULL,
    fk_semestre INT NOT NULL,
    fk_disciplina INT NOT NULL,
    
    qtd_falta INT NOT NULL DEFAULT 0 CHECK (qtd_falta BETWEEN 0 AND 100),
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
        
    CONSTRAINT pk_falta
        PRIMARY KEY (fk_rgm, fk_semestre, fk_disciplina),
        
    CONSTRAINT fk_falta_aluno 
        FOREIGN KEY (fk_rgm) REFERENCES alunos(pk_rgm) ON DELETE CASCADE,
        
    CONSTRAINT fk_falta_oferta 
        FOREIGN KEY (fk_semestre, fk_disciplina) 
        REFERENCES semestre_disciplina(fk_semestre, fk_disciplina) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE notas (
    fk_rgm VARCHAR(15) NOT NULL,
    fk_semestre INT NOT NULL,
    fk_disciplina INT NOT NULL,
    
    valor_nota DECIMAL(4,2) NOT NULL DEFAULT 0.00 CHECK (valor_nota BETWEEN 0.00 AND 10.00),
    atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

    -- AJUSTADO: Correaco do nome da constraint de 'pk_notes' para 'pk_notas'
    CONSTRAINT pk_notas 
        PRIMARY KEY (fk_rgm, fk_semestre, fk_disciplina),

    CONSTRAINT fk_nota_aluno 
        FOREIGN KEY (fk_rgm) REFERENCES alunos(pk_rgm) ON DELETE CASCADE,
        
    CONSTRAINT fk_nota_oferta 
        FOREIGN KEY (fk_semestre, fk_disciplina) 
        REFERENCES semestre_disciplina(fk_semestre, fk_disciplina) ON DELETE CASCADE
) ENGINE=InnoDB;

-- BOLETIM (VIEW)

CREATE OR REPLACE VIEW vw_boletim AS
SELECT 
    a.pk_rgm AS 'RGM',
    p.nome_pessoa AS 'Aluno',
    c.nome_curso AS 'Curso',
    CONCAT(s.numero_semestre, 'º Semestre') AS 'Semestre', 
    d.nome_disciplina AS 'Disciplina',
    
    -- Trata a exibicao para mostrar 0.00 se a nota ainda nao tiver sido lançada
    COALESCE(n.valor_nota, 0.00) AS 'Nota',
    
    COALESCE(f.qtd_falta, 0) AS 'Faltas',
    
    -- Logica de aprovacao inteligente e dinamica
    CASE 
        WHEN COALESCE(f.qtd_falta, 0) > 15 THEN 'Reprovado por Falta'
        WHEN COALESCE(n.valor_nota, 0.00) >= 6.00 THEN 'Aprovado'
        ELSE 'Reprovado por Nota'
    END AS 'Situacao'

FROM alunos a
JOIN pessoas p ON a.fk_pessoa = p.pk_pessoa
JOIN aluno_curso ac ON a.pk_rgm = ac.fk_aluno
JOIN cursos c ON ac.fk_curso = c.pk_curso
JOIN semestres s ON s.fk_curso = c.pk_curso
JOIN semestre_disciplina sd ON sd.fk_semestre = s.pk_semestre
JOIN disciplinas d ON sd.fk_disciplina = d.pk_disciplina
LEFT JOIN notas n ON n.fk_rgm = a.pk_rgm 
                 AND n.fk_semestre = s.pk_semestre 
                 AND n.fk_disciplina = d.pk_disciplina
LEFT JOIN faltas f ON f.fk_rgm = a.pk_rgm 
                 AND f.fk_semestre = s.pk_semestre 
                 AND f.fk_disciplina = d.pk_disciplina;
                 
CREATE OR REPLACE VIEW vw_lista_alunos AS
SELECT 
    a.pk_rgm AS 'RGM',
    p.nome_pessoa AS 'Nome'
FROM alunos a
JOIN pessoas p ON a.fk_pessoa = p.pk_pessoa
ORDER BY p.nome_pessoa ASC;
